# Optional dashboard overrides.
# Values default to the MQTT settings in the repository root .env.

# MQTT_HOST=127.0.0.1
# MQTT_PORT=1883
# MQTT_USERNAME=
# MQTT_PASSWORD=
# MQTT_TOPIC=bluetti

# HTTP/WebSocket server for the dashboard
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8787

# Number of 1-second samples kept in the in-memory history (360 = 6 minutes)
DASHBOARD_HISTORY_POINTS=360
