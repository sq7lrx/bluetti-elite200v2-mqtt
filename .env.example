# Copy to .env and fill in. This single file drives the whole Docker stack
# (broker, bridge and dashboard) as well as the dashboard in local dev.

# Bluetti device
# Find it with: docker compose --profile discovery up bluetti-discovery
BLUETTI_MAC=XX:XX:XX:XX:XX:XX

# MQTT broker
# In the Docker stack the broker is created for you and these values configure
# it. Leave the username and password empty to allow anonymous access.
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=bluetti

# Bridge behaviour
LOG_LEVEL=info
POLLING_INTERVAL=5
HA_CONFIG=normal
VERBOSE=false

# Dashboard
DASHBOARD_PORT=8787
DASHBOARD_HISTORY_POINTS=360

# Only needed when running the bridge or dashboard outside Docker, where there
# is no "mosquitto" service name to resolve.
# MQTT_HOST=127.0.0.1

# Not used by the bridge: encryption is self-contained in
# bluetti_mqtt/bluetooth/encryption.py.
# ENCRYPTION_KEY_FILE=encryption_keys.json
