# Bluetti device configuration
# Replace XX:XX:XX:XX:XX:XX with the real MAC address of your device
BLUETTI_MAC=XX:XX:XX:XX:XX:XX
ENCRYPTION_KEY_FILE=encryption_keys.json

# MQTT configuration
# Replace with the details of your MQTT broker
MQTT_HOST=192.168.1.100
MQTT_PORT=1883
MQTT_USERNAME=mqttuser
MQTT_PASSWORD=mqttpass
MQTT_TOPIC=bluetti

# Logging configuration
LOG_LEVEL=info
